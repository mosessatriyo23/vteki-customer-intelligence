/* Additional Governance, Persona, & Monitoring Styles */
.persona-box {
  padding: 10px 14px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 6px;
  margin: 12px 14px 4px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.persona-label {
  font-size: 8px;
  font-weight: 700;
  color: #8fa093;
  letter-spacing: 0.8px;
  margin-bottom: 4px;
}
.persona-select {
  width: 100%;
  background: #192e23;
  color: #e2ede5;
  border: 1px solid #2f4e3c;
  padding: 5px 8px;
  font-size: 10px;
  border-radius: 4px;
  outline: none;
  cursor: pointer;
}

.provenance-timeline {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 8px;
}
.prov-item {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  font-size: 9px;
  line-height: 1.4;
}
.prov-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-top: 4px;
  flex-shrink: 0;
}
.core-dot { background: #4ca175; }
.feat-dot { background: #3b82f6; }
.dec-dot { background: #eab308; }
.prov-item b { display: block; color: #2e4738; font-size: 10px; }
.prov-item small { display: block; color: #6b776c; font-size: 8px; }
.prov-item time { display: block; color: #8e9b8f; font-size: 7px; margin-top: 2px; }

.action-button-group {
  display: flex;
  gap: 6px;
  align-items: center;
}
.button-sm {
  padding: 4px 8px;
  font-size: 9px;
  font-weight: 600;
  border-radius: 4px;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.button-approve { background: #166534; color: white; }
.button-approve:hover { background: #15803d; }
.button-reject { background: #991b1b; color: white; }
.button-reject:hover { background: #b91c1c; }
.button-launch { background: #1e40af; color: white; }
.button-launch:hover { background: #1d4ed8; }
.text-muted-sm { font-size: 8px; color: #889489; }
.draft-preview-text { display: block; color: #69776b; font-size: 8px; font-style: italic; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.mini-review-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px;
}
.mini-review-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 10px;
  background: #f8faf7;
  border: 1px solid #e5eae2;
  border-radius: 5px;
  font-size: 9px;
}
.mini-review-item b { color: #23382b; font-size: 10px; }
.mini-review-item small { display: block; color: #677569; font-size: 8px; }

.review-grid, .decision-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 16px;
  margin-top: 16px;
}
.review-card, .decision-card {
  padding: 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: white;
  border: 1px solid #e5eae2;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.02);
}
.review-card-header, .decision-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1px solid #f0f4ef;
  padding-bottom: 10px;
  margin-bottom: 12px;
}
.review-id, .nba-id {
  font-size: 8px;
  font-weight: 700;
  color: #728275;
  letter-spacing: 0.5px;
}
.review-card h3, .decision-card h3 {
  margin: 2px 0 0;
  font-size: 13px;
  color: #1f3326;
}

.confidence-meter {
  margin: 10px 0;
}
.confidence-label {
  display: flex;
  justify-content: space-between;
  font-size: 9px;
  color: #556358;
  margin-bottom: 4px;
}
.meter-track {
  height: 6px;
  background: #e5eae2;
  border-radius: 3px;
  overflow: hidden;
}
.meter-fill {
  height: 100%;
  background: linear-gradient(90deg, #eab308, #16a34a);
  border-radius: 3px;
}

.review-reason {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  padding: 8px 10px;
  background: #fefce8;
  border: 1px solid #fef08a;
  border-radius: 5px;
  color: #854d0e;
  font-size: 9px;
  margin-bottom: 12px;
}
.review-reason p { margin: 0; }

.candidates-list {
  font-size: 9px;
}
.candidates-title { font-weight: 700; color: #728275; margin-bottom: 4px; font-size: 8px; }
.candidate-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 8px;
  background: #f0f4ef;
  border-radius: 4px;
  margin-right: 6px;
  margin-bottom: 6px;
  color: #2b3d31;
}

.review-card-footer, .decision-footer {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 14px;
  padding-top: 10px;
  border-top: 1px solid #f0f4ef;
}

.resolved-note {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #166534;
  font-size: 9px;
  font-weight: 600;
  margin-top: 10px;
}

.nba-box {
  padding: 12px;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 6px;
  margin-bottom: 10px;
}
.nba-label { font-size: 8px; font-weight: 700; color: #166534; margin-bottom: 4px; }
.nba-text { font-size: 11px; font-weight: 700; color: #14532d; display: flex; align-items: center; gap: 6px; }
.nba-box small { display: block; color: #15803d; font-size: 8px; margin-top: 4px; }

.override-box {
  padding: 10px;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  border-radius: 6px;
  font-size: 9px;
}
.override-label { font-size: 8px; font-weight: 700; color: #1e40af; display: flex; align-items: center; gap: 4px; margin-bottom: 4px; }
.override-action { color: #1e3a8a; font-size: 11px; display: block; margin-bottom: 4px; }
.override-box p { margin: 0; color: #1d4ed8; font-size: 8px; }

.override-modal { max-width: 520px; }
.builder-body-simple { display: flex; flex-direction: column; gap: 12px; padding: 18px; }

.monitoring-sections { display: flex; flex-direction: column; gap: 18px; margin-top: 16px; }
.trace-panel { padding: 18px; }
.trace-form { margin-top: 12px; display: flex; gap: 10px; }
.trace-search { flex: 1; }
.trace-result-box { margin-top: 14px; padding: 14px; background: #f8faf7; border: 1px solid #e2e8e0; border-radius: 6px; }
.trace-summary { display: flex; gap: 20px; font-size: 10px; border-bottom: 1px solid #e5eae2; padding-bottom: 8px; margin-bottom: 12px; }
.text-green { color: #15803d; }
.trace-steps { display: flex; flex-direction: column; gap: 10px; }
.trace-step-item { display: flex; gap: 12px; font-size: 9px; }
.step-time { width: 90px; color: #728275; font-family: monospace; }
.step-content b { color: #1f3326; font-size: 10px; }
.step-content p { margin: 2px 0 0; color: #4e5c51; }
.step-content small { color: #889489; font-size: 8px; }